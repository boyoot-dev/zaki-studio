# npm 10.9.7's tree builder crashes while resolving vitest's optional browser peers
# ("Cannot read properties of null (reading 'edgesOut')", 2026-11-12). The peers we need
# (vite, and electron-vite's optional @swc/core) are pinned in package.json, so the check is
# turned off rather than leaving the install half done.
legacy-peer-deps=true
